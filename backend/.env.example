# ============================================
# FACEBOOK
# ============================================
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here
FB_VERIFY_TOKEN=my_custom_verify_token_2024
FB_PAGE_ACCESS_TOKEN=your_page_token_here
FB_PAGE_ID=your_page_id_here

# ============================================
# GOOGLE GEMINI (Free)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# DATABASE (Supabase)
# Use the session pooler on port 5432 (transaction pooler 6543 breaks asyncpg
# under SQLAlchemy 2.x with "connection is already closed" errors).
# TLS is enforced in code via connect_args={"ssl": "require"}.
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres.yourref:yourpassword@aws-0-yourregion.pooler.supabase.com:5432/postgres

# ============================================
# REDIS (Upstash)
# ============================================
REDIS_URL=rediss://default:yourpassword@your-redis.upstash.io:6379

# ============================================
# AUTH
# ============================================
JWT_SECRET_KEY=generate-a-random-64-char-string-here
JWT_ALGORITHM=HS256

# ============================================
# APP
# ============================================
APP_ENV=development
APP_URL=https://your-app.railway.app
