# Copy to backend/.env (or set these as host Secrets / Environment Variables).
# All values below are REQUIRED unless marked optional.

# --- Core ---
APP_ENV=production
APP_URL=https://your-space.hf.space
ALLOWED_ORIGINS=https://admin-panel.netlify.app,https://client-panel.netlify.app

# --- Database (Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Redis (Upstash, free, no card) ---
# Format: rediss://:PASSWORD@HOST:PORT
REDIS_URL=rediss://:your-upstash-password@your-upstash-host.upstash.io:6379

# --- Admin ---
ADMIN_JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong
ADMIN_2FA=False

# --- Facebook / Messenger ---
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
FB_VERIFY_TOKEN=any_random_string
FB_PAGE_ACCESS_TOKEN=optional_for_single_page
FB_PAGE_ID=optional_for_single_page
GRAPH_API_VERSION=v21.0

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Email (Brevo, free 300/day, no card) ---
# Leave BREVO_API_KEY empty to disable email (welcome/receipts skipped).
BREVO_API_KEY=
BREVO_FROM_EMAIL=you@verified-sender.com
BREVO_FROM_NAME=Chatrix Support

# --- Product URLs ---
# Where the client dashboard lives + the public webhook callback URL
# (must be the deployed backend, not localhost).
CLIENT_PANEL_URL=https://fb-autoreply-client.netlify.app
WEBHOOK_PUBLIC_URL=https://your-backend.onrender.com

# --- Auth ---
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
